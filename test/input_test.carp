(load "Test.carp")
(use Test)
(load "input.carp")
(use InputManager)

(deftest input-test
  (let [state (Test.State.init 0 0)]
    (let [mgr (InputManager.create NULL)
          _b1 (InputManager.add-binding! &mgr (copy "Jump") (InputSource.Key 32) 1.0)
          
          s1 (assert-equal &state 1 (Array.length (InputManager.bindings &mgr)) "Bindings are added correctly")
          
          ;; Frame 1: Pressed
          _f1_prev (InputManager.set-prev-states! &mgr {})
          _f1_curr (let [states (InputManager.states &mgr)]
                     (Map.put! states "Jump" &(ActionState.Digital true)))
          
          s2 (assert-true &s1 (InputManager.action-digital? &mgr "Jump") "F1: Digital true")
          s3 (assert-true &s2 (InputManager.action-pressed? &mgr "Jump") "F1: Pressed true")
          s4 (assert-true &s3 (not (InputManager.action-released? &mgr "Jump")) "F1: Released false")

          ;; Frame 2: Held
          _f2_prev (InputManager.set-prev-states! &mgr @(InputManager.states &mgr))
          ;; states is already {Jump: true}
          
          s5 (assert-true &s4 (InputManager.action-digital? &mgr "Jump") "F2: Digital true")
          s6 (assert-true &s5 (not (InputManager.action-pressed? &mgr "Jump")) "F2: Pressed false")
          s7 (assert-true &s6 (not (InputManager.action-released? &mgr "Jump")) "F2: Released false")

          ;; Frame 3: Released
          _f3_prev (InputManager.set-prev-states! &mgr @(InputManager.states &mgr))
          _f3_curr (InputManager.set-states! &mgr {})
          
          s8 (assert-true &s7 (not (InputManager.action-digital? &mgr "Jump")) "F3: Digital false")
          s9 (assert-true &s8 (not (InputManager.action-pressed? &mgr "Jump")) "F3: Pressed false")
          s10 (assert-true &s9 (InputManager.action-released? &mgr "Jump") "F3: Released true")
          ]
      s10)))
